<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground del adaptive icon.
    El canvas total es 108dp, la zona segura (safe zone) es el círculo interior de ~66dp.
    Se aplica un inset del ~18% por lado (~20dp) para centrar el logo dentro de la zona segura
    y evitar que se recorte en launchers que aplican máscara circular/cuadrada.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="18dp"
        android:right="18dp"
        android:top="18dp"
        android:bottom="18dp"
        android:drawable="@drawable/apk_icono" />
</layer-list>
