<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="160dp"
            android:layout_height="110dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MODIFICAR DATOS USUARIO"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- NOMBRES -->
        <EditText
            android:id="@+id/etEditNombres"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:hint="INGRESE NOMBRES"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:textColor="@color/primary_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- APELLIDOS -->
        <EditText
            android:id="@+id/etEditApellidos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:hint="INGRESE APELLIDOS"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:textColor="@color/primary_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- E-MAIL -->
        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:hint="INGRESE E-MAIL"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:textColor="@color/primary_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Botones MODIFICAR (Verde) y ELIMINAR (Rojo) lado a lado como en la maqueta 10 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModificar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_green"
                android:text="MODIFICAR"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_red"
                android:text="ELIMINAR"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
