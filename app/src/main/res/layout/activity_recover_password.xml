<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="160dp"
            android:layout_height="111dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="RECUPERAR CONTRASEÑA"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Campo Ingrese Email -->
        <EditText
            android:id="@+id/etEmailRecover"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:hint="INGRESE EMAIL"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:textColor="@color/primary_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Botón RECUPERAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecuperar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary_red"
            android:text="RECUPERAR"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/tvSubCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="INGRESE CÓDIGO"
            android:textColor="@color/primary_dark"
            android:textSize="14sp" />

        <!-- Casillas de Código de 6 dígitos para PHPMailer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/code1"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code2"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code3"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code4"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code5"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code6"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_code_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contador como en la maqueta (59 Segundos) -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="59 Segundos"
            android:textColor="@color/primary_dark"
            android:textSize="14sp" />

        <!-- Botón para continuar tras validar código -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnValidarCodigo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary_dark"
            android:text="VERIFICAR CÓDIGO"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
